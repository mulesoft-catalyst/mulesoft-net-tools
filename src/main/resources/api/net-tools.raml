#%RAML 1.0
title: Network connectivity tools
version: 2.0
securedBy: [basic]
securitySchemes:
  basic:
    type: Basic Authentication

types:
  ToolOperation:
    type: string
    enum: [ping, traceroute, socket, dns, curl, certest, ciphertest]
  ToolRequest:
    type: object
    properties:
      operation:
        type: ToolOperation
      host?:
        description: The domain or IP of the host to test
        type: string
      port?:
        description: The port number of the host to test
        type: string
      dnsServer?:
        description: The DNS server to use for resolution
        type: string
      url?:
        description: Target URL for curl
        type: string
      headers?:
        description: Headers to pass to curl
        type: string[]
      insecure?:
        description: Allow insecure TLS connections for curl
        type: boolean
      noProgressMeter?:
        description: Suppress curl progress meter output
        type: boolean
      connectTimeout?:
        description: Maximum time in seconds curl may spend connecting
        type: number
      maxTime?:
        description: Maximum total time in seconds curl may spend on the request
        type: number
      forwardProxy?:
        description: curl-compatible forward proxy URL, including http, socks4, socks5, or socks5h
        type: string
      proxyInsecure?:
        description: Allow insecure TLS connections to HTTPS forward proxies for curl
        type: boolean
      targetMethod?:
        description: HTTP method curl should use
        type: string
        enum: [GET, POST]
      body?:
        description: Payload for curl POST requests
        type: string

/tools:
  post:
    description: Runs a network tool operation from the Mule host
    body:
      application/json:
        type: ToolRequest
        example: |
          {
            "operation": "ping",
            "host": "localhost"
          }
    responses:
      200:
        body:
          text/plain:
            example: |
              Tool output...
      400:
        body:
          text/plain:
            example: Missing host
