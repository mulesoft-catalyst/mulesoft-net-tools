#%RAML 1.0
title: Network connectivity tools
version: 2.0
securedBy: [basic]
securitySchemes:
  basic:
    type: Basic Authentication

/ping:
  get:
    description: Runs an ICMP test from the Mule host to the specified endpoint
    queryParameters:
      host:
        description: The domain or ip of the host to ping
        type: string
    responses: 
      200:
        body: 
          text/plain:
            example: |
              PING localhost (127.0.0.1): 56 data bytes
              64 bytes from 127.0.0.1: icmp_seq=0 ttl=64 time=0.050 ms
              64 bytes from 127.0.0.1: icmp_seq=1 ttl=64 time=0.070 ms
              64 bytes from 127.0.0.1: icmp_seq=2 ttl=64 time=0.054 ms
              64 bytes from 127.0.0.1: icmp_seq=3 ttl=64 time=0.046 ms

              --- localhost ping statistics ---
              4 packets transmitted, 4 packets received, 0.0% packet loss
              round-trip min/avg/max/stddev = 0.046/0.055/0.070/0.009 ms

/socket:
  get:
    description: Creates a TCP socket to test connectivity to an IP:Port combination
    queryParameters:
      host:
        description: The domain or ip of the host to be tested
        type: string
      port:
        description: The port number of host to be tested
        type: number
    responses: 
      200:
        body: 
          text/plain:
            example: |
              Connectivity is successful
/traceroute:
  get:
    description: Runs a traceroute test from the Mule host to the specified endpoint
    queryParameters:
      host:
        description: The domain or ip of the host to traceroute
        type: string
    responses: 
      200:
        body: 
          text/plain:
            example: |
               1  216.182.237.132  1.203 ms 216.182.237.128  1.185 ms 216.182.237.132  1.681 ms
               2  100.64.1.13  1.671 ms 100.64.1.235  1.337 ms 100.64.1.205  1.649 ms
               3  100.64.0.184  469.084 ms 100.64.0.210  992.624 ms 100.64.0.216  1012.502 ms
               4  100.64.16.43  0.777 ms 100.64.16.47  0.940 ms 100.64.16.91  0.904 ms
               5  72.21.222.221  1.588 ms 72.21.222.223  1.561 ms 72.21.222.221  1.581 ms
               6  54.240.242.42  12.569 ms 54.240.243.142  3.572 ms 54.240.242.102  18.003 ms
               7  54.240.243.93  1.225 ms 54.240.242.13  1.249 ms  1.244 ms
               8  52.95.216.113  1.092 ms  0.878 ms  0.972 ms
               9  216.239.50.189  1.963 ms 216.239.54.205  2.139 ms 216.239.49.9  1.962 ms
               10  216.239.58.213  2.424 ms 64.233.174.43  2.246 ms 216.239.58.215  1.577 ms
               11  8.8.8.8  1.824 ms  1.383 ms  1.339 ms
/dns:
  get:
    description: Resolves the specified endpoint's IP using the hosts DNS servers
    queryParameters:
      host:
        description: The the fully qualified domain name the host to test
        type: string
      dnsServer:
        description: The DNS server to use for resolution.        
        type: string
        required: false
    responses: 
      200:
        body: 
          text/plain:
            example: |
               127.0.0.1
/curl:
  get:
    description: Runs a curl from the Mule host to the specified resource
    queryParameters:
      url:
        description: Target URL
        type: string 
      header:
        required: false
        items:
          type: string
          example: |
            Authorization:Basic YQxhZGRpbjpvcGVuc2VzYW1l
    responses: 
      200:
        body: 
          text/plain:
            example: |
              curl: (7) Failed to connect to 10.200.27.15 port 443: Timed out
  post:
    description: Runs a comprehensive curl request with advanced options from the Mule host to the specified resource
    body:
      application/json:
        type: object
        properties:
          url:
            description: Target URL
            type: string
            required: true
          method:
            description: HTTP method (GET, POST, PUT, DELETE, PATCH, etc.)
            type: string
            required: true
            enum: [GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS]
          headers:
            description: HTTP headers to include in the request
            type: array
            items:
              type: string
              example: "Content-Type:application/json"
            required: false
          payload:
            description: Request body content (ignored for GET requests)
            type: any
            required: false
            example: {"name":"John","email":"john@example.com"}
          insecure:
            description: Skip SSL certificate validation
            type: boolean
            required: false
            default: false
          timeout:
            description: Connection timeout in seconds (0 for no timeout)
            type: integer
            required: false
            default: 0
          followRedirects:
            description: Whether to follow HTTP redirects
            type: boolean
            required: false
            default: true
          basicAuth:
            description: Basic authentication credentials in format "username:password"
            type: string
            required: false
            example: "admin:password123"
          proxy:
            description: Proxy server in format "host:port"
            type: string
            required: false
            example: "proxy.example.com:8080"
    responses:
      200:
        body:
          text/plain:
            description: The full response including headers and body
            example: |
              HTTP/1.1 201 Created
              Date: Mon, 12 Jun 2023 15:30:22 GMT
              Content-Type: application/json
              Content-Length: 157
              Connection: keep-alive
              
              {
                "id": "123456",
                "name": "John",
                "email": "john@example.com",
                "created_at": "2023-06-12T15:30:22Z"
              }
/database/select:
  post:
    description: Executes a SQL query against a database
    body:
      application/json:
        type: object
        properties:
          url:
            description: The JDBC URL of the database
            type: string
            required: true
          sql:
            description: The SQL query to execute
            type: string
            required: true
    responses:
      200:
        body:
          application/json:
            example: |
              [
                {
                  "column1": "value1",
                  "column2": "value2"
                },
                {
                  "column1": "value3",
                  "column2": "value4"
                }
              ]
/database/sp:
  post:
    description: Executes a stored procedure against a database
    body:
      application/json:
        type: object
        properties:
          url:
            description: The JDBC URL of the database
            type: string
            required: true
          sql:
            description: The SQL query to execute
            type: string
            required: true
          inputParameters:
            description: The input parameters for the stored procedure
            type: object
            required: false
          inOutParameters:
            description: The in-out parameters for the stored procedure
            type: object
            required: false
          outputParameters:
            description: The output parameters for the stored procedure
            type: array
            required: false
            items:
              type: object
              properties:
                key:
                  type: string
                'type':
                  type: string
          
    responses:
      200:
        body:
          application/json:
            example: |
              {
                "output": {
                  "param3": 123
                },
                "updatedInOutParameters": {
                  "param2": "new_value"
                }
              }
/database/script:
  post:
    description: Executes a SQL script against a database
    body:
      application/json:
        type: object
        properties:
          url:
            description: The JDBC URL of the database
            type: string
            required: true
          sql:
            description: The SQL script to execute
            type: string
            required: true
    responses:
      200:
        body:
          application/json:
            example: |
              {
                "message": "Script executed successfully"
              }
    

/ciphertest:
  get:
    description: Checks available SSL cipher suites for a given endpoint
    queryParameters:
      host:
        description: The domain or ip of the host to connect to
        type: string
      port:
        description: The port number of host to be tested
        type: number        
    responses: 
      200:
        body: 
          text/plain:
            example: List of supported ciphers...

/certest:
  get:
    description: Runs an SSL connection and pulls the certificates found
    queryParameters:
      host:
        description: The domain or ip of the host to connect to
        type: string
      port:
        description: The port number of host to be tested
        type: number        
    responses: 
      200:
        body: 
          text/plain:
            example: CONNECTED(00000005)
